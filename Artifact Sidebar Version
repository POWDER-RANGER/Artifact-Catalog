var COLORS={space:'#1aab7d',ai:'#8075e5',game:'#e05c28',sec:'#db4f7a',music:'#c07c10',sys:'#3585e0',web:'#5fa318',hw:'#8f8f85',write:'#9a7245'};
var LABELS={space:'Space / Viz',ai:'AI / Agent',game:'Gaming',sec:'Security',music:'Music',sys:'Systems',web:'Web / UI',hw:'Hardware',write:'Writing'};
var STLABEL={pub:'Published',act:'Active',arc:'Archived'};
var ORDER=['space','ai','game','sec','music','sys','web','hw','write'];
var CATS=['space','ai','game','sec','music','sys','web','hw','write'];
var af='all',as='',timer=null;

function match(w,q){if(!q)return true;return(w.t+' '+w.d+' '+w.tags.join(' ')+(w.i||'')).toLowerCase().indexOf(q.toLowerCase())>=0;}
function filtered(cat){return W.filter(function(w){return(cat==='all'||w.c===cat)&&match(w,as);});}

function updateCounts(){
  var all=filtered('all');
  document.getElementById('count-all').textContent=all.length;
  document.getElementById('stat-total').textContent=all.length;
  var pub=0,act=0,arc=0;
  all.forEach(function(w){if(w.s==='pub')pub++;else if(w.s==='act')act++;else arc++;});
  document.getElementById('leg-pub').textContent=pub;
  document.getElementById('leg-act').textContent=act;
  document.getElementById('leg-arc').textContent=arc;
  CATS.forEach(function(c){var el=document.getElementById('count-'+c);if(el)el.textContent=filtered(c).length;});
}

function updateDomainPill(){
  var pill=document.getElementById('active-domain');
  if(af==='all'){pill.classList.remove('visible');return;}
  pill.classList.add('visible');
  document.getElementById('ad-dot').style.background=COLORS[af]||'#555';
  document.getElementById('ad-label').textContent=LABELS[af];
}

function render(){
  var g=document.getElementById('grid');
  var rc=document.getElementById('rc');
  var ws=filtered(af);
  updateCounts();updateDomainPill();
  rc.textContent=ws.length+' / '+W.length;
  if(!ws.length){g.innerHTML='<div class="empty">No artifacts match.</div>';return;}
  var html='';
  if(af==='all'){
    ORDER.forEach(function(cat){
      var group=ws.filter(function(w){return w.c===cat;});
      if(!group.length)return;
      html+='<div class="sec-head" style="--ac:'+COLORS[cat]+'"><div class="sh-name">'+LABELS[cat]+'</div><div class="sh-rule"></div><div class="sh-n">'+group.length+'</div></div>';
      html+=group.map(function(w,i){return makeCard(w,i);}).join('');
    });
  } else {
    html=ws.map(function(w,i){return makeCard(w,i);}).join('');
  }
  g.style.opacity='0';g.style.transform='translateY(6px)';
  requestAnimationFrame(function(){
    g.innerHTML=html;
    requestAnimationFrame(function(){
      g.style.transition='opacity .18s ease,transform .18s ease';
      g.style.opacity='1';g.style.transform='translateY(0)';
    });
  });
}

function makeCard(w,i){
  var tags=w.tags.map(function(t){return'<span class="tag">'+t+'</span>';}).join('');
  var badge=w.s?'<span class="badge '+w.s+'">'+STLABEL[w.s]+'</span>':'';
  var itr=w.i?'<div class="c-itr">'+w.i+'</div>':'';
  var delay=Math.min(i,16)*18;
  return'<div class="wc" style="--ac:'+COLORS[w.c]+';animation-delay:'+delay+'ms">'+
    '<div class="c-head"><div class="c-domain">'+LABELS[w.c]+'</div><div class="c-badges">'+badge+'</div></div>'+
    '<div class="c-title">'+w.t+'</div>'+
    '<div class="c-desc">'+w.d+'</div>'+itr+
    '<div class="c-foot"><div class="c-tags">'+tags+'</div><div class="c-age">'+w.a+' ago</div></div>'+
    '</div>';
}

document.getElementById('nav').addEventListener('click',function(e){
  var b=e.target.closest('.nf');if(!b)return;
  af=b.getAttribute('data-f');
  document.querySelectorAll('.nf').forEach(function(x){x.classList.remove('on');});
  b.classList.add('on');
  document.getElementById('scroll').scrollTop=0;
  render();
});

document.getElementById('ad-clear').addEventListener('click',function(){
  af='all';
  document.querySelectorAll('.nf').forEach(function(x){x.classList.remove('on');});
  document.querySelector('.nf[data-f="all"]').classList.add('on');
  render();
});

document.getElementById('search').addEventListener('input',function(e){
  as=e.target.value;clearTimeout(timer);timer=setTimeout(render,80);
});

render();
</script>
</body>
</html>
