<style>
*{box-sizing:border-box;margin:0;padding:0}
button{border:none;cursor:pointer;background:none;font-family:inherit}
:root{
  --bg:#06060a;--bg-side:#09090e;--bg-card:#0d0d13;--bg-card-h:#121219;--bg-search:#0d0d13;
  --br-faint:#131318;--br-dim:#1c1c26;--br-mid:#27272f;--br-light:#35353f;
  --tx-1:#f0f0f4;--tx-2:#86869a;--tx-3:#4a4a58;--tx-4:#28282f;
  --c-space:#1aab7d;--c-ai:#8075e5;--c-game:#e05c28;--c-sec:#db4f7a;
  --c-music:#c07c10;--c-sys:#3585e0;--c-web:#5fa318;--c-hw:#8f8f85;--c-write:#9a7245;
  --f-display:'Barlow Condensed',sans-serif;--f-body:'Barlow',sans-serif;--f-mono:'JetBrains Mono',monospace;
  --side-w:272px;
}
html,body{height:100%}
body{background:var(--bg);color:var(--tx-1);font-family:var(--f-body);display:grid;grid-template-columns:var(--side-w) 1fr;height:100vh;overflow:hidden;}
#side{background:var(--bg-side);border-right:1px solid var(--br-dim);display:flex;flex-direction:column;height:100vh;overflow-y:auto;overflow-x:hidden;scrollbar-width:none;flex-shrink:0;}
#side::-webkit-scrollbar{display:none}
#logo-block{padding:28px 24px 22px;border-bottom:1px solid var(--br-dim);}
.logo-mark{font-family:var(--f-display);font-weight:800;font-size:22px;letter-spacing:3px;text-transform:uppercase;color:var(--tx-1);line-height:1;display:block;}
.logo-sub{font-family:var(--f-mono);font-size:9px;color:var(--tx-3);letter-spacing:1.5px;display:block;margin-top:8px;text-transform:uppercase;}
#side-stats{padding:16px 24px;display:grid;grid-template-columns:1fr 1fr;gap:10px 0;border-bottom:1px solid var(--br-dim);}
.ss{display:flex;flex-direction:column;gap:2px}
.ss-n{font-family:var(--f-display);font-weight:700;font-size:22px;letter-spacing:1px;color:var(--tx-1);line-height:1;}
.ss-l{font-family:var(--f-mono);font-size:8px;color:var(--tx-3);letter-spacing:1.5px;text-transform:uppercase;}
.nav-section{padding:14px 24px 6px;font-family:var(--f-mono);font-size:8px;letter-spacing:2px;text-transform:uppercase;color:var(--tx-4);}
#nav{padding:0 12px;flex:1}
.nf{display:flex;align-items:center;gap:10px;width:100%;padding:8px 12px;border-radius:4px;transition:background .1s;margin-bottom:1px;text-align:left;}
.nf:hover{background:var(--br-faint)}
.nf.on{background:var(--br-dim)}
.nf-dot{width:8px;height:8px;border-radius:2px;flex-shrink:0;background:var(--dc,var(--tx-3));transition:opacity .1s;}
.nf:not(.on) .nf-dot{opacity:.45}
.nf-name{font-family:var(--f-display);font-weight:600;font-size:13px;letter-spacing:1px;text-transform:uppercase;color:var(--tx-2);flex:1;transition:color .1s;}
.nf.on .nf-name{color:var(--tx-1)}
.nf-count{font-family:var(--f-mono);font-size:10px;color:var(--tx-3);flex-shrink:0;transition:color .1s;min-width:24px;text-align:right;}
.nf.on .nf-count{color:var(--tx-2)}
.nf[data-f="all"].on{background:var(--tx-1);}
.nf[data-f="all"].on .nf-name{color:var(--bg-side)}
.nf[data-f="all"].on .nf-count{color:var(--bg-side);opacity:.6}
#side-legend{padding:16px 24px;border-top:1px solid var(--br-dim);margin-top:auto;}
.leg-title{font-family:var(--f-mono);font-size:8px;letter-spacing:2px;text-transform:uppercase;color:var(--tx-4);margin-bottom:10px;}
.leg-item{display:flex;align-items:center;gap:8px;margin-bottom:6px;}
.leg-dot{width:6px;height:6px;border-radius:50%;flex-shrink:0;}
.leg-dot.pub{background:#2ec77a}.leg-dot.act{background:#5ca8f0}.leg-dot.arc{background:#35353f}
.leg-label{font-family:var(--f-mono);font-size:9px;color:var(--tx-3);letter-spacing:.5px;flex:1;}
.leg-n{font-family:var(--f-mono);font-size:9px;color:var(--tx-4);}
#main{display:flex;flex-direction:column;height:100vh;overflow:hidden;background:var(--bg);background-image:radial-gradient(circle,var(--br-faint) 1px,transparent 1px);background-size:22px 22px;}
#search-bar{padding:20px 28px 16px;border-bottom:1px solid var(--br-dim);background:var(--bg);flex-shrink:0;display:flex;align-items:center;gap:16px;position:relative;z-index:10;}
#search{flex:1;background:var(--bg-search);border:1px solid var(--br-mid);color:var(--tx-1);font-family:var(--f-mono);font-size:12px;padding:10px 14px;border-radius:4px;outline:none;letter-spacing:.3px;transition:border-color .15s,box-shadow .15s;}
#search:focus{border-color:var(--br-light);box-shadow:0 0 0 3px rgba(255,255,255,.04);}
#search::placeholder{color:var(--tx-4);letter-spacing:.5px}
#search-meta{display:flex;align-items:center;gap:16px;flex-shrink:0;}
#rc{font-family:var(--f-mono);font-size:10px;color:var(--tx-3);letter-spacing:.5px;white-space:nowrap;}
#active-domain{display:none;align-items:center;gap:6px;background:var(--br-dim);border:1px solid var(--br-mid);border-radius:3px;padding:4px 10px 4px 8px;}
#active-domain.visible{display:flex}
#ad-dot{width:6px;height:6px;border-radius:2px;}
#ad-label{font-family:var(--f-display);font-weight:600;font-size:11px;letter-spacing:1px;text-transform:uppercase;color:var(--tx-2);}
#ad-clear{font-family:var(--f-mono);font-size:10px;color:var(--tx-3);margin-left:6px;cursor:pointer;padding:0 2px;transition:color .1s;}
#ad-clear:hover{color:var(--tx-2)}
#scroll{flex:1;overflow-y:auto;padding:24px 28px 60px;scrollbar-width:thin;scrollbar-color:var(--br-mid) transparent;}
#scroll::-webkit-scrollbar{width:4px}
#scroll::-webkit-scrollbar-track{background:transparent}
#scroll::-webkit-scrollbar-thumb{background:var(--br-mid);border-radius:2px}
.sec-head{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:16px;margin:36px 0 16px;opacity:0;animation:fadeUp .25s forwards;}
.sec-head:first-child{margin-top:0}
.sh-name{font-family:var(--f-display);font-weight:800;font-size:28px;letter-spacing:3px;text-transform:uppercase;color:var(--ac);line-height:1;}
.sh-rule{height:1px;background:linear-gradient(to right,var(--ac),transparent);opacity:.25;}
.sh-n{font-family:var(--f-mono);font-size:11px;color:var(--tx-3);letter-spacing:1px;white-space:nowrap;}
#grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(290px,1fr));gap:10px;}
.wc{background:var(--bg-card);border:1px solid var(--br-dim);border-left:none;border-radius:0 5px 5px 0;padding:14px 16px 13px;position:relative;transition:background .12s,border-color .12s,transform .12s;opacity:0;animation:fadeUp .22s forwards;overflow:hidden;}
.wc::before{content:'';position:absolute;left:0;top:0;bottom:0;width:4px;background:var(--ac);border-radius:2px 0 0 2px;}
.wc::after{content:'';position:absolute;inset:0;background:radial-gradient(ellipse at 0% 50%,color-mix(in srgb,var(--ac) 6%,transparent) 0%,transparent 55%);pointer-events:none;border-radius:inherit;}
.wc:hover{background:var(--bg-card-h);border-color:var(--br-mid);transform:translateX(2px);}
.c-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;gap:8px;}
.c-domain{font-family:var(--f-mono);font-size:7.5px;letter-spacing:2px;text-transform:uppercase;color:var(--ac);opacity:.85;}
.c-badges{display:flex;gap:4px;flex-shrink:0}
.badge{font-family:var(--f-mono);font-size:7px;padding:2px 6px;border-radius:2px;letter-spacing:1px;text-transform:uppercase;border:1px solid;line-height:1.6;}
.badge.pub{background:#0c2a1a;color:#2ec77a;border-color:#174a2a}
.badge.act{background:#0c1d35;color:#5ca8f0;border-color:#163050}
.badge.arc{background:#111116;color:#333340;border-color:#1c1c24}
.c-title{font-family:var(--f-display);font-weight:700;font-size:16px;letter-spacing:.5px;color:var(--tx-1);line-height:1.25;margin-bottom:7px;text-transform:uppercase;}
.c-desc{font-family:var(--f-body);font-weight:300;font-size:11px;color:var(--tx-2);line-height:1.65;letter-spacing:.1px;}
.c-itr{display:inline-flex;align-items:center;gap:4px;margin-top:8px;font-family:var(--f-mono);font-size:7.5px;color:var(--ac);opacity:.75;letter-spacing:.5px;}
.c-itr::before{content:'';display:block;width:8px;height:1px;background:var(--ac);opacity:.6;}
.c-foot{display:flex;align-items:flex-end;justify-content:space-between;margin-top:10px;gap:8px;}
.c-tags{display:flex;flex-wrap:wrap;gap:3px;flex:1}
.tag{font-family:var(--f-mono);font-size:7.5px;padding:2px 5px;border-radius:2px;background:var(--bg);color:var(--tx-3);border:1px solid var(--br-faint);letter-spacing:.2px;line-height:1.6;}
.c-age{font-family:var(--f-mono);font-size:8.5px;color:var(--tx-4);white-space:nowrap;letter-spacing:.3px;flex-shrink:0;}
.empty{grid-column:1/-1;padding:5rem 0;text-align:center;font-family:var(--f-mono);font-size:11px;color:var(--tx-4);letter-spacing:1px;}
@keyframes fadeUp{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
@media(max-width:760px){
  body{grid-template-columns:1fr;grid-template-rows:auto 1fr;overflow:auto;height:auto;}
  #side{height:auto;flex-direction:row;flex-wrap:wrap;overflow:visible;border-right:none;border-bottom:1px solid var(--br-dim);}
  #logo-block{border-bottom:none;border-right:1px solid var(--br-dim);flex-shrink:0}
  #side-stats{display:none}
  #nav{display:flex;flex-wrap:wrap;padding:8px;gap:4px;flex:1}
  .nf{padding:5px 10px;width:auto}
  .nf-dot{display:none}
  #side-legend{display:none}
  .nav-section{display:none}
  #main{height:auto;overflow:visible}
  #scroll{overflow:visible;padding:16px}
}
</style>
</head>
