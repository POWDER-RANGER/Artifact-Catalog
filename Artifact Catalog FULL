<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>POWDER-RANGER — Work Catalog</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=DM+Mono:ital,wght@0,300;0,400;0,500;1,400&family=Bebas+Neue&family=DM+Sans:wght@300;400;500&display=swap');

*{box-sizing:border-box;margin:0;padding:0}

:root{
  --bg:#080808;
  --bg2:#0e0e0e;
  --bg3:#141414;
  --bg4:#1a1a1a;
  --b1:#1e1e1e;
  --b2:#272727;
  --b3:#333;
  --t1:#efefef;
  --t2:#999;
  --t3:#555;
  --t4:#333;
  --space:#1D9E75;
  --ai:#7F77DD;
  --game:#D85A30;
  --sec:#D4537E;
  --music:#BA7517;
  --sys:#378ADD;
  --web:#639922;
  --hw:#888780;
  --write:#8B6F47;
  --accent:#efefef;
  --mono:'DM Mono',monospace;
  --display:'Bebas Neue',sans-serif;
  --body:'DM Sans',sans-serif;
}

html{scroll-behavior:smooth}

body{
  background:var(--bg);
  color:var(--t1);
  font-family:var(--mono);
  min-height:100vh;
  overflow-x:hidden;
}

body::before{
  content:'';
  position:fixed;
  inset:0;
  background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.035'/%3E%3C/svg%3E");
  pointer-events:none;
  z-index:1000;
  opacity:1;
}

#wrap{max-width:1440px;margin:0 auto;padding:0 2rem 6rem;}

#hdr{
  display:grid;
  grid-template-columns:1fr auto;
  align-items:end;
  gap:2rem;
  padding:3rem 0 2.5rem;
  border-bottom:1px solid var(--b2);
  margin-bottom:2.5rem;
  position:relative;
}

#hdr::after{
  content:'';
  position:absolute;
  bottom:-1px;left:0;
  width:120px;height:1px;
  background:var(--t1);
}

.logo-word{font-family:var(--display);font-size:clamp(48px,6vw,84px);letter-spacing:3px;line-height:1;color:var(--t1);display:block;}
.logo-sub{font-family:var(--mono);font-size:10px;color:var(--t3);letter-spacing:2.5px;text-transform:uppercase;margin-top:10px;display:block;}
.hdr-right{text-align:right;font-family:var(--mono);font-size:9px;color:var(--t3);letter-spacing:.5px;line-height:2.2;padding-bottom:4px;}

#stats{display:flex;gap:0;margin-bottom:2.5rem;border:1px solid var(--b2);border-radius:4px;overflow:hidden;background:var(--bg2);}
.st{flex:1;padding:18px 20px;border-right:1px solid var(--b2);position:relative;transition:background .15s;}
.st:last-child{border-right:none}
.st::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:var(--sc,var(--t3));opacity:.4;}
.st:nth-child(1){--sc:var(--space)}
.st:nth-child(2){--sc:var(--ai)}
.st:nth-child(3){--sc:var(--game)}
.st:nth-child(4){--sc:var(--sec)}
.st:nth-child(5){--sc:var(--music)}
.sn{font-family:var(--display);font-size:36px;letter-spacing:1px;color:var(--t1);line-height:1;display:block;}
.sl{font-family:var(--mono);font-size:8px;color:var(--t3);letter-spacing:2px;margin-top:6px;text-transform:uppercase;display:block;}

#search-row{display:flex;gap:10px;margin-bottom:14px;align-items:center;}
#search{flex:1;background:var(--bg2);border:1px solid var(--b2);color:var(--t1);font-family:var(--mono);font-size:11px;padding:10px 14px;border-radius:3px;outline:none;letter-spacing:.5px;transition:border-color .15s;}
#search:focus{border-color:var(--b3)}
#search::placeholder{color:var(--t4)}
#rc{font-family:var(--mono);font-size:9px;color:var(--t3);letter-spacing:.5px;white-space:nowrap;min-width:70px;text-align:right;}

#fb{display:flex;flex-wrap:wrap;gap:5px;margin-bottom:2rem;}
.fb{font-family:var(--mono);font-size:9px;padding:5px 12px;border-radius:2px;border:1px solid var(--b1);cursor:pointer;background:transparent;color:var(--t3);letter-spacing:1.5px;text-transform:uppercase;transition:all .1s;position:relative;overflow:hidden;}
.fb::before{content:'';position:absolute;left:0;top:0;bottom:0;width:2px;background:var(--fc,transparent);transition:opacity .1s;opacity:0;}
.fb:hover{color:var(--t2);border-color:var(--b3)}
.fb.on{color:var(--t1);border-color:var(--b3);background:var(--bg3);}
.fb.on::before{opacity:1}
.fb[data-f="all"].on{background:var(--t1);color:var(--bg);border-color:var(--t1);}
.fb[data-f="space"]{--fc:var(--space)}
.fb[data-f="ai"]{--fc:var(--ai)}
.fb[data-f="game"]{--fc:var(--game)}
.fb[data-f="sec"]{--fc:var(--sec)}
.fb[data-f="music"]{--fc:var(--music)}
.fb[data-f="sys"]{--fc:var(--sys)}
.fb[data-f="web"]{--fc:var(--web)}
.fb[data-f="hw"]{--fc:var(--hw)}
.fb[data-f="write"]{--fc:var(--write)}

.section-header{grid-column:1/-1;display:flex;align-items:center;gap:16px;margin:2rem 0 .75rem;opacity:0;animation:fadeUp .3s forwards;}
.sh-line{flex:1;height:1px;background:var(--b2);}
.sh-label{font-family:var(--display);font-size:13px;letter-spacing:4px;color:var(--ac);white-space:nowrap;}
.sh-count{font-family:var(--mono);font-size:9px;color:var(--t4);letter-spacing:1px;}

#grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:8px;transition:opacity .15s ease;}
#grid.fading{opacity:0}

.wc{background:var(--bg2);border:1px solid var(--b1);border-radius:4px;padding:14px 16px 12px;position:relative;overflow:hidden;transition:border-color .15s,background .15s,transform .15s;cursor:default;opacity:0;animation:fadeUp .25s forwards;}
.wc::before{content:'';position:absolute;top:0;left:0;width:100%;height:2px;background:var(--ac);opacity:.7;}
.wc::after{content:'';position:absolute;inset:0;background:radial-gradient(ellipse at 20% 0%,color-mix(in srgb,var(--ac) 5%,transparent) 0%,transparent 60%);pointer-events:none;}
.wc:hover{border-color:var(--b3);background:var(--bg3);transform:translateY(-1px);}

.card-top{display:flex;align-items:flex-start;justify-content:space-between;gap:8px;margin-bottom:8px;}
.cl{font-family:var(--mono);font-size:7.5px;letter-spacing:2px;text-transform:uppercase;color:var(--ac);opacity:.9;line-height:1;}
.badges{display:flex;gap:4px;flex-shrink:0;}
.badge{font-family:var(--mono);font-size:7px;padding:2px 6px;border-radius:2px;letter-spacing:1px;text-transform:uppercase;border:1px solid;}
.badge.pub{background:#0b2a17;color:#3dd68c;border-color:#174a2a}
.badge.act{background:#0b1d33;color:#5ca8f0;border-color:#163050}
.badge.arc{background:#141414;color:#3a3a3a;border-color:#222}

.ct{font-family:var(--body);font-size:12.5px;font-weight:500;color:var(--t1);line-height:1.4;margin-bottom:6px;letter-spacing:.1px;}
.cd{font-family:var(--mono);font-size:10px;color:var(--t2);line-height:1.6;letter-spacing:.1px;}
.itr{display:inline-block;font-family:var(--mono);font-size:7.5px;color:var(--ac);opacity:.7;margin-top:6px;letter-spacing:.5px;border:1px solid;border-color:color-mix(in srgb,var(--ac) 30%,transparent);padding:1px 5px;border-radius:2px;}
.card-meta{display:flex;align-items:flex-end;justify-content:space-between;margin-top:10px;gap:6px;}
.tags{display:flex;flex-wrap:wrap;gap:3px;flex:1;}
.tag{font-family:var(--mono);font-size:7.5px;padding:2px 5px;border-radius:2px;background:var(--bg3);color:var(--t4);border:1px solid var(--b1);letter-spacing:.3px;}
.ca{font-family:var(--mono);font-size:8px;color:var(--t4);white-space:nowrap;letter-spacing:.3px;flex-shrink:0;}

.empty{grid-column:1/-1;color:var(--t4);font-family:var(--mono);font-size:11px;padding:3rem 0;letter-spacing:.5px;text-align:center;}

@keyframes fadeUp{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:translateY(0)}}

#foot{margin-top:4rem;padding-top:2rem;border-top:1px solid var(--b1);display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:1rem;}
.foot-logo{font-family:var(--display);font-size:20px;letter-spacing:2px;color:var(--t4);}
.foot-note{font-family:var(--mono);font-size:9px;color:var(--t4);letter-spacing:.5px;}

@media(max-width:600px){
  #hdr{grid-template-columns:1fr}
  .hdr-right{text-align:left}
  #stats{flex-wrap:wrap}
  .st{flex:1 1 calc(50% - 1px)}
}
</style>
</head>
