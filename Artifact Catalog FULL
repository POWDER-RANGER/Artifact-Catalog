var COLORS={space:'#1D9E75',ai:'#7F77DD',game:'#D85A30',sec:'#D4537E',music:'#BA7517',sys:'#378ADD',web:'#639922',hw:'#888780',write:'#8B6F47'};
var LABELS={space:'Space / Viz',ai:'AI / Agent',game:'Gaming',sec:'Security',music:'Music',sys:'Systems',web:'Web / UI',hw:'Hardware',write:'Writing'};
var STLABEL={pub:'Published',act:'Active',arc:'Archived'};
var ORDER=['space','ai','game','sec','music','sys','web','hw','write'];
var af='all',as='',renderTimer=null;

function match(w,q){if(!q)return true;return(w.t+' '+w.d+' '+w.tags.join(' ')+(w.i||'')).toLowerCase().indexOf(q.toLowerCase())>=0;}

function render(){
  var g=document.getElementById('grid');
  var rc=document.getElementById('rc');
  var ws=W.filter(function(w){return(af==='all'||w.c===af)&&match(w,as);});
  rc.textContent=ws.length+' of '+W.length;
  if(!ws.length){g.innerHTML='<div class="empty">No artifacts match.</div>';return;}
  var html='';
  if(af==='all'){
    ORDER.forEach(function(cat){
      var group=ws.filter(function(w){return w.c===cat;});
      if(!group.length)return;
      html+='<div class="section-header" style="--ac:'+COLORS[cat]+'"><div class="sh-label">'+LABELS[cat]+'</div><div class="sh-line"></div><div class="sh-count">'+group.length+'</div></div>';
      html+=group.map(function(w,i){return card(w,i);}).join('');
    });
  } else {
    html=ws.map(function(w,i){return card(w,i);}).join('');
  }
  g.classList.add('fading');
  requestAnimationFrame(function(){g.innerHTML=html;g.classList.remove('fading');});
}

function card(w,i){
  var tags=w.tags.map(function(t){return'<span class="tag">'+t+'</span>';}).join('');
  var badge=w.s?'<span class="badge '+w.s+'">'+STLABEL[w.s]+'</span>':'';
  var itr=w.i?'<span class="itr">'+w.i+'</span>':'';
  var delay=(i%20)*12;
  return'<div class="wc" style="--ac:'+COLORS[w.c]+';animation-delay:'+delay+'ms">'+
    '<div class="card-top"><div class="cl">'+LABELS[w.c]+'</div><div class="badges">'+badge+'</div></div>'+
    '<div class="ct">'+w.t+'</div>'+
    '<div class="cd">'+w.d+'</div>'+
    (itr?'<div style="margin-top:6px">'+itr+'</div>':'')+
    '<div class="card-meta"><div class="tags">'+tags+'</div><div class="ca">'+w.a+' ago</div></div>'+
    '</div>';
}

document.getElementById('fb').addEventListener('click',function(e){
  var b=e.target.closest('.fb');if(!b)return;
  af=b.getAttribute('data-f');
  document.querySelectorAll('.fb').forEach(function(x){x.classList.remove('on');x.style.background='';x.style.color='';x.style.borderColor='';});
  b.classList.add('on');
  if(af==='all'){b.style.background='var(--t1)';b.style.color='var(--bg)';b.style.borderColor='var(--t1)';}
  else{b.style.background='';b.style.color='var(--t1)';b.style.borderColor='var(--b3)';}
  render();
});

document.getElementById('search').addEventListener('input',function(e){
  as=e.target.value;
  clearTimeout(renderTimer);
  renderTimer=setTimeout(render,80);
});

render();
</script>
</body>
</html>
